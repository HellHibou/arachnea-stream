# Release version used by an explicit `docker compose build`. The build wrapper
# resolves it to the highest `release-*` directory when it is not set. Compose
# runtime always starts the local `arachnea-stream:latest` alias; a value
# exported in the environment wins (`ARACHNEA_VERSION=0.2.0 docker compose build`).
#ARACHNEA_VERSION=0.1.0

# Root of the release tree (output of `node build-release/release.mjs`),
# relative to this compose file (`../releases` = `<project>/releases`). It
# feeds the `releases` named build context (`additional_contexts` in
# docker-compose.yml); a value exported in the environment wins over it
# (`ARACHNEA_RELEASES_DIR=/srv/arachnea/releases docker compose build`).
ARACHNEA_RELEASES_DIR=../releases

# REST server port. It drives both sides of the published port
# (`"${ARACHNEA_PORT}:..."` in docker-compose.yml), the `server_port` pinned
# by the entrypoint in `/app/data/config.json`, and the `image:` healthcheck
# probe. A value exported in the environment wins over it
# (`ARACHNEA_PORT=9090 docker compose up -d`).
ARACHNEA_PORT=8080

# Client access rule: `local` (loopback only) | `private` (container-local
# networks) | `public` (any peer). Keep `public` for published ports: traffic
# forwarded by the Docker host does not originate from the container's own
# subnets, so `private`/`local` answer 404 to it. Use `private` only for
# container-to-container calls on the same Docker network. Pinned by the
# entrypoint in `/app/data/config.json` (`network_mode`); a value exported in
# the environment wins over it.
ARACHNEA_NETWORK=public

# Public URL prefix (no leading/trailing slash, e.g. `arachnea`) when the
# service sits behind a path-based reverse proxy: the entrypoint writes it as
# `entrypoint_root` in `/app/data/config.json` and the app is served from
# `/<prefix>/` (`GET /` redirects there). Empty by default: no prefix, the app
# is served from `/`. A value exported in the environment wins over it.
ARACHNEA_ROOT=