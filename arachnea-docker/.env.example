# Template for `.env` (same folder, committed with the version to build).
# Compose interpolates these values into the build context and args of
# docker-compose.yml; a value exported in the environment wins.
#ARACHNEA_VERSION=0.1.0

# Root of the release tree, relative to this compose file
# (`../releases` = `<project>/releases`).
ARACHNEA_RELEASES_DIR=../releases

# REST server port (drives both sides of the published port, `server_port` in
# config.json, and the healthcheck probe).
ARACHNEA_PORT=8080

# Client access rule: `local` | `private` | `public` (see `.env` comments).
ARACHNEA_NETWORK=public

# Public URL prefix behind a path-based reverse proxy (empty = serve from `/`).
ARACHNEA_ROOT=