{
  "name": "arachnea-release",
  "version": "0.1.1",
  "private": true,
  "description": "Local cross-platform release builder for Arachnea (Tauri).",
  "type": "module",
  "scripts": {
    "list": "node release.mjs --list",
    "release": "node release.mjs",
    "release:mac": "node release.mjs darwin-universal",
    "release:windows": "node release.mjs windows-x86_64",
    "release:linux": "node release.mjs linux-x86_64",
    "install-tools": "node install-tools.mjs",
    "version": "node release.mjs --version"
  }
}