{
  "versionSource": "../server/Cargo.toml",
  "tauriProject": "../server/crates/arachnea-stream",
  "frontendProject": "../front",
  "changelog": "../CHANGELOG.md",
  "productName": "arachnea",
  "portableSource": "../server",
  "portable": {
    "include": ["services"],
    "exclude": ["credentials", "credentials.json", "cache", "store-proxy-inventory.json", "store-cloudflare-session.json"]
  },
  "platforms": [
    {
      "id": "darwin-universal",
      "target": "universal-apple-darwin",
      "needsTargets": ["aarch64-apple-darwin", "x86_64-apple-darwin"],
      "bundles": ["dmg"],
      "portable": false
    },
    {
      "id": "darwin-x86_64",
      "target": "x86_64-apple-darwin",
      "bundles": ["dmg"],
      "build": "docker",
      "portable": {
        "format": "targz",
        "exeName": "arachnea"
      }
    },
    {
      "id": "darwin-arm64",
      "target": "aarch64-apple-darwin",
      "bundles": ["dmg"],
      "build": "docker",
      "portable": {
        "format": "targz",
        "exeName": "arachnea"
      }
    },
    {
      "id": "windows-x86_64",
      "target": "x86_64-pc-windows-msvc",
      "runner": "cargo-xwin",
      "bundles": ["nsis", "msi"],
      "portable": {
        "exeName": "arachnea.exe"
      }
    },
    {
      "id": "windows-arm64",
      "target": "aarch64-pc-windows-msvc",
      "runner": "cargo-xwin",
      "bundles": ["nsis", "msi"],
      "portable": {
        "exeName": "arachnea.exe"
      }
    },
    {
      "id": "linux-x86_64",
      "target": "x86_64-unknown-linux-gnu",
      "bundles": ["deb", "rpm", "appimage"],
      "build": "docker",
      "portable": {
        "format": "targz",
        "exeName": "arachnea"
      }
    },
    {
      "id": "linux-arm64",
      "target": "aarch64-unknown-linux-gnu",
      "bundles": ["deb", "rpm", "appimage"],
      "build": "docker",
      "portable": {
        "format": "targz",
        "exeName": "arachnea"
      }
    }
  ]
}
