{
  "$schema": "../../gen/schemas/desktop-schema.json",
  "productName": "Arachnéa",
  "version": "0.1.0",
  "identifier": "hell-hibou.arachnea",
  "mainBinaryName": "arachnea",
  "build": {
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../../../front"
    },
    "frontendDist": "../../../front/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "capabilities": ["main-capability", "cloudflare-solver-capability", "logs-window-capability"]
    },
    "windows": [
      {
        "label": "main",
        "title": "Arachnéa Stream",
        "fullscreen": false,
        "resizable": true,
        "maximized": true, 
        "fullscreen": false,
        "maximizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../../server/services": "services/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
